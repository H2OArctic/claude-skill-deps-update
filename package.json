{
  "name": "claude-skill-deps-update",
  "version": "2.0.1",
  "description": "Skill for Claude Code: safe dependency updates in Bun monorepos — risk-classified bumps, lockfile-accurate override verdicts, supply-chain checks, peer-conflict detection, lockfile rebuild",
  "type": "module",
  "license": "MIT",
  "bin": {
    "claude-skill-deps-update": "./bin/cli.ts"
  },
  "scripts": {
    "skill:install": "bun bin/cli.ts install",
    "skill:update": "bun bin/cli.ts update",
    "skill:hook": "bun bin/cli.ts hook",
    "skill:status": "bun bin/cli.ts status",
    "skill:uninstall": "bun bin/cli.ts uninstall",
    "scan": "bun bin/cli.ts scan",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit -p tsconfig.json"
  },
  "keywords": [
    "claude-code",
    "claude-skill",
    "bun",
    "monorepo",
    "dependencies",
    "semver",
    "overrides",
    "audit",
    "supply-chain",
    "lockfile"
  ],
  "engines": {
    "bun": ">=1.4.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0"
  }
}
